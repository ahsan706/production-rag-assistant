PROJECT_NAME=Production RAG Assistant
ENVIRONMENT=development

POSTGRES_DB=rag_assistant
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
DATABASE_URL=postgresql+psycopg://rag:rag@postgres:5432/rag_assistant

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
UPLOAD_DIR=/data/uploads
EXTRACTION_DIR=/data/extracted
MAX_UPLOAD_BYTES=10485760

API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Later phases use these OpenAI-compatible settings.
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=ollama
AI_CHAT_MODEL=qwen2.5:0.5b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
QDRANT_COLLECTION=rag_chunks
AI_REQUEST_TIMEOUT_SECONDS=120
QDRANT_REQUEST_TIMEOUT_SECONDS=20
